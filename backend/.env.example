# ── Required ──────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/school_attendance"
JWT_SECRET="generate-a-long-random-string"

# ── Server ────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV="development"

# ── Frontend origins (CORS) ──────────────────────────────────────────
CLIENT_URL="http://localhost:5173"
# Set to your deployed frontend URL for production CORS (e.g. Vercel).
# Falls back to CLIENT_URL if empty.
FRONTEND_URL=""

# ── School identity ───────────────────────────────────────────────────
SCHOOL_NAME="My School"

# ── Geofence defaults (seed only; editable at runtime via admin settings) ──
SCHOOL_LATITUDE=-1.9441
SCHOOL_LONGITUDE=30.0619
GEOFENCE_RADIUS=100

# ── Attendance timing (server local time, 24-hour HH:MM) ─────────────
ATTENDANCE_START_TIME=07:30
LATE_AFTER_TIME=08:00

# ── Face verification ────────────────────────────────────────────────
# Cosine-similarity threshold for face match (0-1, default 0.55)
# FACE_MATCH_THRESHOLD=0.55
# Optional: dedicated key for encrypting face embeddings (falls back to JWT_SECRET hash)
# FACE_ENCRYPTION_KEY=""

# ── First admin seed account (seed script only) ──────────────────────
# Set a strong random password. The example below is ONLY a placeholder —
# never use it in production (Require it on Railway).
ADMIN_NAME="System Administrator"
ADMIN_EMAIL="admin@school.com"
ADMIN_PASSWORD="CHANGE_ME_IN_RAILWAY"

# ── Test database (optional; used by Jest tests) ─────────────────────
DATABASE_URL_TEST="postgresql://USER:PASSWORD@localhost:5432/school_attendance_test"
